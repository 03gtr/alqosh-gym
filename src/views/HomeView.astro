---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import HoursCard from '../components/HoursCard.astro';
import DiscountCard from '../components/DiscountCard.astro';
import MuscleCard from '../components/MuscleCard.astro';
import ExerciseGrid from '../components/ExerciseGrid.astro';
import NutritionCard from '../components/NutritionCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import TipCard from '../components/TipCard.astro';
import QRCTA from '../components/QRCTA.astro';
import { gym } from '../config/gym';
import { MUSCLE_CATEGORIES, TRAINING_CATEGORIES } from '../data/taxonomy';
import { exercisesForCategory, getExercise } from '../data/exercises';
import type { Exercise } from '../data/exercises/types';
import { getArticles, readingMinutes, splitId } from '../utils/content';
import ContactLinks from '../components/ContactLinks.astro';
import { localePath, useT, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const other = lang === 'ar' ? 'en' : 'ar';

const FEATURED = ['back-squat', 'barbell-bench-press', 'lat-pulldown', 'romanian-deadlift', 'dumbbell-shoulder-press', 'seated-cable-row', 'leg-press', 'plank'];
const featured = FEATURED.map(getExercise).filter((e): e is Exercise => Boolean(e));
const categories = [...MUSCLE_CATEGORIES, ...TRAINING_CATEGORIES];
const articles = (await getArticles(lang, 'health')).slice(0, 4);
---

<BaseLayout lang={lang} path="/">
  <!-- HERO -->
  <section class="hero grunge">
    <div class="hero-shapes" aria-hidden="true">
      <span class="shape s1"></span><span class="shape s2"></span><span class="shape s3"></span>
    </div>
    <div class="container hero-inner">
      <p class="eyebrow">{t('hero.kicker')}</p>
      <h1 class="hero-title">
        <span class="hero-en display" lang="en" dir="ltr">ALQOSH <em>GYM</em></span>
        <span class="hero-ar" lang="ar" dir="rtl">{gym.name.ar}</span>
      </h1>
      <p class="hero-tagline">{t('site.tagline')}</p>
      <p class="hero-tagline-alt" lang={other} dir={other === 'ar' ? 'rtl' : 'ltr'}>
        {other === 'ar' ? 'تمرّن صح. تحرك صح. كن أقوى.' : 'Train Smart. Move Right. Get Stronger.'}
      </p>
      <div class="hero-ctas">
        <a class="btn btn--primary" href={localePath(lang, '/exercises/')}>{t('hero.ctaExercises')}</a>
        <a class="btn btn--ghost" href={localePath(lang, '/calculator/')}>{t('hero.ctaCalories')}</a>
        <a class="btn" href={localePath(lang, '/gym/')}>{t('hero.ctaGym')}</a>
      </div>
    </div>
  </section>

  <!-- QUICK GYM INFO -->
  <section class="section--tight quick" aria-labelledby="quick-title">
    <div class="container">
      <h2 id="quick-title" class="sr-only">{t('home.quickInfo')}</h2>
      <div class="quick-grid">
        <HoursCard lang={lang} who="men" compact />
        <HoursCard lang={lang} who="women" compact />
        {gym.benefits.map((b) => <DiscountCard benefit={b} lang={lang} />)}
      </div>
      <p class="policy-line">
        <span class="slash" aria-hidden="true"></span>
        <strong>{gym.discountPolicy.headline[lang]}</strong>
        <a class="link-arrow" href={localePath(lang, '/gym/#benefits')}>{t('common.learnMore')}</a>
      </p>
      <ContactLinks lang={lang} class="home-contact" />
    </div>
  </section>

  <!-- SEARCH -->
  <section class="section search-section" aria-labelledby="search-title">
    <div class="container narrow">
      <h2 id="search-title" class="section-title">{t('home.searchTitle')}</h2>
      <p class="muted search-hint">{t('home.searchHint')}</p>
      <SearchBar lang={lang} examples id="home-q" />
    </div>
  </section>

  <!-- QR -->
  <section class="section--tight">
    <div class="container">
      <QRCTA lang={lang} />
    </div>
  </section>

  <!-- MUSCLES -->
  <section class="section" aria-labelledby="muscles-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{t('nav.muscles')}</p>
          <h2 id="muscles-title" class="section-title">{t('home.browseMuscles')}</h2>
        </div>
        <a class="link-arrow" href={localePath(lang, '/muscles/')}>{t('home.allMuscles')}</a>
      </div>
      <div class="grid muscles-grid">
        {categories.map((c) => <MuscleCard lang={lang} category={c} count={exercisesForCategory(c).length} />)}
      </div>
    </div>
  </section>

  <!-- FEATURED EXERCISES -->
  <section class="section featured" aria-labelledby="featured-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{t('nav.exercises')}</p>
          <h2 id="featured-title" class="section-title">{t('home.featured')}</h2>
        </div>
        <a class="link-arrow" href={localePath(lang, '/exercises/')}>{t('home.viewLibrary')}</a>
      </div>
      <ExerciseGrid exercises={featured} lang={lang} />
    </div>
  </section>

  <!-- PATHS & TOOLS -->
  <section class="section" aria-labelledby="paths-title">
    <div class="container">
      <h2 id="paths-title" class="section-title">{t('home.pathsTitle')}</h2>
      <div class="grid grid--2 paths">
        <NutritionCard lang={lang} path="/beginner/" icon="user" title={t('nav.beginner')} text={t('home.pathBeginner')} accent />
        <NutritionCard lang={lang} path="/advanced/" icon="bolt" title={t('nav.advanced')} text={t('home.pathAdvanced')} />
        <NutritionCard lang={lang} path="/workouts/" icon="dumbbell" title={t('workout.title')} text={t('home.pathBuilder')} />
        <NutritionCard lang={lang} path="/calculator/" icon="calculator" title={t('calc.title')} text={t('home.pathCalc')} />
        <NutritionCard lang={lang} path="/nutrition/meals/" icon="nutrition" title={t('meals.title')} text={t('meals.plannerIntro')} />
        <NutritionCard lang={lang} path="/nutrition/" icon="book" title={t('nutrition.title')} text={t('nutrition.intro')} />
      </div>
    </div>
  </section>

  <!-- TIP -->
  <section class="section--tight">
    <div class="container">
      <TipCard lang={lang} />
    </div>
  </section>

  <!-- HEALTH -->
  <section class="section" aria-labelledby="health-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{t('nav.health')}</p>
          <h2 id="health-title" class="section-title">{t('home.healthTitle')}</h2>
        </div>
        <a class="link-arrow" href={localePath(lang, '/health/')}>{t('home.allArticles')}</a>
      </div>
      <div class="grid grid--3">
        {articles.map((a) => (
          <ArticleCard lang={lang} slug={splitId(a.id).slug} title={a.data.title} description={a.data.description} icon={a.data.icon} minutes={readingMinutes(a.body)} />
        ))}
      </div>
    </div>
  </section>

  <!-- IDENTITY & COACH -->
  <section class="section identity grunge" aria-labelledby="identity-title">
    <div class="container identity-inner">
      <div>
        <p class="eyebrow">{t('gym.identity')}</p>
        <h2 id="identity-title" class="section-title">{gym.name[lang]}</h2>
        <p class="lead">{t('gym.identityBody')}</p>
        <p class="pillars">{t('gym.pillars')}</p>
      </div>
      <div class="coach card card--cut">
        <p class="eyebrow">{t('gym.coach')}</p>
        <p class="coach-name">{gym.coach.display.ar}</p>
        <p class="coach-name-en" lang="en" dir="ltr">{gym.coach.display.en}</p>
        <p class="muted">{t('gym.coachNote')}</p>
        <a class="link-arrow" href={localePath(lang, '/gym/')}>{t('gym.more')}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative; overflow: hidden;
    padding-block: 40px 44px;
    background: radial-gradient(120% 90% at 85% 0%, rgb(225 6 0 / 0.28), transparent 55%), var(--black);
    border-block-end: 1px solid var(--line);
  }
  :global(html[dir='rtl']) .hero { background: radial-gradient(120% 90% at 15% 0%, rgb(225 6 0 / 0.28), transparent 55%), var(--black); }
  .hero-shapes { position: absolute; inset: 0; pointer-events: none; }
  .shape { position: absolute; background: var(--accent); transform: skewX(-22deg); }
  .s1 { inline-size: 26px; block-size: 140%; top: -20%; inset-inline-end: 18%; opacity: 0.9; }
  .s2 { inline-size: 10px; block-size: 140%; top: -20%; inset-inline-end: calc(18% + 44px); opacity: 0.6; }
  .s3 { inline-size: 70px; block-size: 140%; top: -20%; inset-inline-end: -20px; opacity: 0.12; }
  .hero-inner { position: relative; display: grid; gap: 12px; justify-items: start; }
  .hero-title { display: grid; gap: 4px; margin-block: 4px 6px; }
  .hero-en { font-size: var(--fs-hero); color: var(--white); text-shadow: 0 4px 30px rgb(0 0 0 / 0.6); }
  .hero-en em { font-style: normal; color: var(--accent); }
  .hero-ar { font-size: clamp(1.9rem, 1.2rem + 3.6vw, 3.6rem); font-weight: 900; line-height: 1.2; color: var(--white); }
  .hero-tagline { font-size: clamp(1.15rem, 1rem + 1vw, 1.6rem); font-weight: 900; }
  .hero-tagline-alt { color: var(--text-muted); font-weight: 700; margin-block-start: -6px; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-block-start: 10px; }
  @media (max-width: 480px) {
    .hero-ctas { display: grid; grid-template-columns: 1fr 1fr; inline-size: 100%; }
    .hero-ctas .btn:first-child { grid-column: 1 / -1; }
  }
  @media (min-width: 1024px) { .hero { padding-block: 72px 80px; } }

  .quick-grid { display: grid; gap: 12px; grid-template-columns: 1fr; }
  @media (min-width: 560px) { .quick-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .quick-grid { grid-template-columns: repeat(3, 1fr); } }
  .policy-line { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; margin-block-start: 16px; }
  .quick :global(.home-contact) { margin-block-start: 14px; }

  .search-section { background: var(--ink-900); border-block: 1px solid var(--line); }
  .narrow { max-width: 820px; }
  .search-hint { margin-block-end: 16px; }

  .muscles-grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 165px), 1fr)); gap: 10px; }
  @media (max-width: 360px) { .muscles-grid { grid-template-columns: 1fr; } }
  .paths { margin-block-start: 16px; }

  .identity { background: var(--ink-900); border-block-start: 1px solid var(--line); }
  .identity-inner { display: grid; gap: 24px; align-items: center; }
  @media (min-width: 900px) { .identity-inner { grid-template-columns: 1.4fr 1fr; } }
  .pillars { margin-block-start: 14px; font-weight: 800; color: var(--accent-text); }
  .coach { display: grid; gap: 4px; background: var(--ink-700); }
  .coach-name { font-size: var(--fs-xl); font-weight: 900; }
  .coach-name-en { font-family: var(--font-display); font-size: 1.8rem; letter-spacing: 0.03em; color: var(--text-muted); }
</style>
