---
/**
 * Home — organised around what the visitor wants to do (value first, gym
 * information second): hero → goals → exercise discovery → beginner →
 * tools → gym information → permanent benefits → coaching team.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import HoursCard from '../components/HoursCard.astro';
import MuscleCard from '../components/MuscleCard.astro';
import NutritionCard from '../components/NutritionCard.astro';
import GoalPicker from '../components/GoalPicker.astro';
import BenefitList from '../components/BenefitList.astro';
import CoachCards from '../components/CoachCards.astro';
import ContactLinks from '../components/ContactLinks.astro';
import Icon from '../components/Icon.astro';
import { gym } from '../config/gym';
import { MUSCLE_CATEGORIES, TRAINING_CATEGORIES } from '../data/taxonomy';
import { exercisesForCategory } from '../data/exercises';
import { localePath, useT, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const categories = [...MUSCLE_CATEGORIES, ...TRAINING_CATEGORIES];
---

<BaseLayout lang={lang} path="/">
  <!-- HERO: what this is + where to start -->
  <section class="hero grunge">
    <div class="hero-shapes" aria-hidden="true">
      <span class="shape s1"></span><span class="shape s2"></span><span class="shape s3"></span>
    </div>
    <div class="container hero-inner">
      <h1 class="hero-brand">
        <span class="hero-en display" lang="en" dir="ltr">ALQOSH <em>GYM</em></span>
        <span class="hero-ar" lang="ar" dir="rtl">{gym.name.ar}</span>
      </h1>
      <p class="hero-title">{t('hero.title')}</p>
      <p class="hero-lead">{t('hero.lead')}</p>
      <div class="hero-ctas">
        <a class="btn btn--primary" href={localePath(lang, '/exercises/')}>{t('hero.ctaExercises')}</a>
        <a class="btn btn--ghost" href="#goals">{t('hero.ctaGoal')}</a>
      </div>
      <p class="hero-links">
        <a href={localePath(lang, '/beginner/')}><Icon name="user" size={18} />{t('nav.beginner')}</a>
        <a href={localePath(lang, '/calculator/')}><Icon name="calculator" size={18} />{t('hero.ctaCalories')}</a>
        <a href={localePath(lang, '/gym/')}><Icon name="clock" size={18} />{t('hero.ctaGym')}</a>
      </p>
    </div>
  </section>

  <!-- GOALS -->
  <section class="section" id="goals" aria-labelledby="goals-title">
    <div class="container">
      <h2 id="goals-title" class="section-title">{t('home.goalsTitle')}</h2>
      <p class="section-lead">{t('home.goalsLead')}</p>
      <GoalPicker lang={lang} />
    </div>
  </section>

  <!-- EXERCISE DISCOVERY -->
  <section class="section discover" aria-labelledby="discover-title">
    <div class="container">
      <h2 id="discover-title" class="section-title">{t('home.searchTitle')}</h2>
      <p class="section-lead">{t('home.searchHint')}</p>
      <SearchBar lang={lang} examples id="home-q" />
      <div class="muscles-head">
        <h3 class="sub-title">{t('home.browseMuscles')}</h3>
        <a class="link-arrow" href={localePath(lang, '/muscles/')}>{t('home.allMuscles')}</a>
      </div>
      <ul class="muscle-scroller" role="list">
        {categories.map((c) => <li><MuscleCard lang={lang} category={c} count={exercisesForCategory(c).length} /></li>)}
      </ul>
      <a class="btn btn--sm all-ex" href={localePath(lang, '/exercises/')}>{t('home.allExercises')}</a>
    </div>
  </section>

  <!-- BEGINNER -->
  <section class="section--tight" aria-labelledby="beginner-title">
    <div class="container">
      <div class="beginner card--cut">
        <div>
          <h2 id="beginner-title" class="beginner-title">{t('home.beginnerTitle')}</h2>
          <p class="beginner-body">{t('home.beginnerBody')}</p>
        </div>
        <a class="btn btn--primary" href={localePath(lang, '/beginner/')}>{t('home.beginnerCta')}</a>
      </div>
    </div>
  </section>

  <!-- TOOLS -->
  <section class="section" aria-labelledby="tools-title">
    <div class="container">
      <h2 id="tools-title" class="section-title">{t('home.toolsTitle')}</h2>
      <div class="tools">
        <NutritionCard lang={lang} path="/calculator/" icon="calculator" title={t('calc.title')} text={t('home.pathCalc')} />
        <NutritionCard lang={lang} path="/nutrition/meals/" icon="nutrition" title={t('meals.title')} text={t('meals.plannerIntro')} />
        <NutritionCard lang={lang} path="/workouts/" icon="dumbbell" title={t('workout.title')} text={t('home.pathBuilder')} />
      </div>
      <p class="more-links">
        <a class="link-arrow" href={localePath(lang, '/nutrition/')}>{t('nutrition.title')}</a>
        <a class="link-arrow" href={localePath(lang, '/health/')}>{t('home.allArticles')}</a>
        <a class="link-arrow" href={localePath(lang, '/advanced/')}>{t('nav.advanced')}</a>
      </p>
    </div>
  </section>

  <!-- GYM INFORMATION -->
  <section class="section gym-info" aria-labelledby="gym-title">
    <div class="container">
      <h2 id="gym-title" class="section-title">{t('hero.ctaGym')}</h2>
      <p class="section-lead">{t('home.gymLead')}</p>
      <div class="hours">
        <HoursCard lang={lang} who="men" compact />
        <HoursCard lang={lang} who="women" compact />
      </div>
      <ContactLinks lang={lang} class="home-contact" />
      <p class="more-links">
        <a class="link-arrow" href={localePath(lang, '/women/')}>{t('home.womenLink')}</a>
        <a class="link-arrow" href={localePath(lang, '/gym/')}>{t('gym.more')}</a>
      </p>

      <h2 class="section-title gym-sub" id="benefits-title">{t('gym.benefits')}</h2>
      <BenefitList lang={lang} />

      <h2 class="section-title gym-sub" id="coaches-title">{t('gym.coaches')}</h2>
      <CoachCards lang={lang} />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative; overflow: hidden;
    padding-block: 32px 36px;
    background: radial-gradient(120% 90% at 85% 0%, rgb(225 6 0 / 0.28), transparent 55%), var(--black);
    border-block-end: 1px solid var(--line);
  }
  :global(html[dir='rtl']) .hero { background: radial-gradient(120% 90% at 15% 0%, rgb(225 6 0 / 0.28), transparent 55%), var(--black); }
  .hero-shapes { position: absolute; inset: 0; pointer-events: none; }
  .shape { position: absolute; background: var(--accent); transform: skewX(-22deg); }
  .s1 { inline-size: 22px; block-size: 140%; top: -20%; inset-inline-end: 12%; opacity: 0.85; }
  .s2 { inline-size: 8px; block-size: 140%; top: -20%; inset-inline-end: calc(12% + 38px); opacity: 0.55; }
  .s3 { inline-size: 70px; block-size: 140%; top: -20%; inset-inline-end: -24px; opacity: 0.12; }
  .hero-inner { position: relative; display: grid; gap: 10px; justify-items: start; }
  .hero-brand { display: grid; gap: 2px; margin: 0; }
  .hero-en { font-size: clamp(2.6rem, 1.4rem + 6vw, 6rem); color: var(--white); line-height: 0.95; }
  .hero-en em { font-style: normal; color: var(--accent); }
  .hero-ar { font-size: clamp(1.4rem, 1rem + 2vw, 2.4rem); font-weight: 900; line-height: 1.3; color: var(--text-muted); }
  .hero-title { font-size: clamp(1.5rem, 1.1rem + 2.2vw, 2.6rem); font-weight: 900; line-height: 1.3; margin-block-start: 8px; max-inline-size: 22ch; text-wrap: balance; }
  .hero-lead { color: var(--text-muted); font-size: var(--fs-md); max-inline-size: 52ch; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-block-start: 8px; }
  .hero-links { display: flex; flex-wrap: wrap; gap: 4px 18px; }
  .hero-links a {
    display: inline-flex; align-items: center; gap: 8px; min-block-size: 44px;
    color: var(--white); font-weight: 800; text-decoration: none;
  }
  .hero-links a:hover { text-decoration: underline; }
  .hero-links :global(.icon) { color: var(--accent-text); }
  @media (max-width: 480px) {
    .hero-ctas { display: grid; grid-template-columns: 1fr 1fr; inline-size: 100%; }
    .hero-ctas .btn { padding-inline: 10px; white-space: nowrap; }
  }
  @media (min-width: 1024px) { .hero { padding-block: 64px 72px; } }

  .section-lead { color: var(--text-muted); margin-block-end: 16px; max-inline-size: 60ch; }
  .sub-title { font-size: var(--fs-lg); }

  .discover { background: var(--ink-900); border-block: 1px solid var(--line); }
  .muscles-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-block: 28px 8px; }
  /* One swipeable row instead of a tall grid of 16 cards. */
  .muscle-scroller {
    display: grid; grid-auto-flow: column; grid-auto-columns: minmax(200px, 62%); gap: 10px;
    overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory;
    padding-block-end: 8px; scrollbar-width: thin;
  }
  .muscle-scroller > li { scroll-snap-align: start; }
  .muscle-scroller :global(.muscle-card) { block-size: 100%; }
  @media (min-width: 640px) { .muscle-scroller { grid-auto-columns: minmax(210px, 30%); } }
  @media (min-width: 1024px) {
    .muscle-scroller { grid-auto-flow: row; grid-template-columns: repeat(4, minmax(0, 1fr)); overflow: visible; }
  }
  .all-ex { margin-block-start: 14px; }

  .beginner {
    display: grid; gap: 16px; align-items: center; padding: 22px;
    background: linear-gradient(135deg, rgb(225 6 0 / 0.22), var(--ink-800) 65%);
    border: 1px solid rgb(225 6 0 / 0.45);
  }
  @media (min-width: 768px) { .beginner { grid-template-columns: 1fr auto; padding: 28px 32px; } }
  .beginner-title { font-size: var(--fs-xl); }
  .beginner-body { color: var(--text-muted); margin-block-start: 6px; max-inline-size: 60ch; }

  .tools { display: grid; gap: 10px; margin-block-start: 12px; }
  @media (min-width: 900px) { .tools { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .more-links { display: flex; flex-wrap: wrap; gap: 0 20px; margin-block-start: 8px; }

  .gym-info { background: var(--ink-900); border-block-start: 1px solid var(--line); }
  .hours { display: grid; gap: 10px; }
  @media (min-width: 640px) { .hours { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .gym-info :global(.home-contact) { margin-block-start: 14px; }
  .gym-sub { font-size: var(--fs-xl); margin-block: 36px 10px; }
</style>
