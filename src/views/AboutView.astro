---
import BaseLayout from '../layouts/BaseLayout.astro';
import QRCTA from '../components/QRCTA.astro';
import PageHeader from '../components/PageHeader.astro';
import { gym } from '../config/gym';
import { brandAssets, company, product } from '../config/product';
import { exercises } from '../data/exercises';
import { localePath, url, useT, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<BaseLayout lang={lang} path="/about/" title={t('about.title')} description={gym.copy.aboutIntro[lang]}>
  <PageHeader lang={lang} title={t('about.title')} lead={gym.copy.aboutIntro[lang]} crumbs={[{ label: t('nav.about') }]} />
  <div class="container section--tight about">
    <section class="card">
      <h2>{gym.name[lang]}</h2>
      <p>{gym.copy.identity[lang]}</p>
      <p><a class="link-arrow" href={localePath(lang, '/gym/')}>{t('gym.more')}</a></p>
    </section>

    <section class="card">
      <h2>{t('about.content')}</h2>
      <p>{t('about.contentBody')}</p>
      <p class="muted">{t('ex.count', { n: exercises.length })} · <a href={localePath(lang, '/exercises/')}>{t('ex.libraryTitle')}</a></p>
    </section>

    <section class="card">
      <h2>{t('about.media')}</h2>
      <p>{t('about.mediaBody')}</p>
    </section>

    <section class="card">
      <h2>{t('disclaimer.title')}</h2>
      <p>{t('disclaimer.short')}</p>
    </section>

    <QRCTA lang={lang} />

    <section class="card product" id="product" aria-labelledby="product-h">
      <h2 id="product-h">{t('about.productTitle')}</h2>
      <img class="about-logo" src={url(brandAssets.logoWeb.src)} width={brandAssets.logoWeb.width} height={brandAssets.logoWeb.height} alt={`${product.name} — ${product.syriacName}`} loading="lazy" decoding="async" />
      <p>{product.about[lang]}</p>
      <ol class="hierarchy" role="list">
        <li><span class="h-role">{t('about.roleCompany')}</span><strong lang="en" dir="ltr">{company.name}</strong></li>
        <li><span class="h-role">{t('about.roleProduct')}</span><strong lang="en" dir="ltr">{product.name}</strong></li>
        <li><span class="h-role">{t('about.roleGym')}</span><strong>{gym.name[lang]}</strong></li>
      </ol>
      <p class="install-link"><a class="link-arrow" href={localePath(lang, '/install/')}>{t('install.title')}</a></p>
    </section>

    <section class="card credits" id="credits" aria-labelledby="credits-h">
      <h2 id="credits-h">{t('about.credits')}</h2>
      <p class="credit-line"><span lang="ar" dir="rtl">{company.credit.ar}</span> · <span lang="en" dir="ltr">{company.credit.en}</span></p>
      <p class="muted">{gym.copy.developerNote[lang]}</p>
      {company.url && <p><a href={company.url} target="_blank" rel="noopener">iq-group.app</a></p>}
    </section>
  </div>
</BaseLayout>

<style>
  .about { display: grid; gap: 14px; max-width: 860px; }
  .about h2 { font-size: var(--fs-lg); margin-block-end: 6px; }
  .about p + p { margin-block-start: 8px; }
  .credits { border-inline-start: 3px solid var(--line-strong); background: var(--ink-900); }
  .credit-line { font-weight: 800; }
  .about-logo { display: block; inline-size: min(240px, 70%); block-size: auto; margin-block: 8px 12px; border-radius: 12px; }
  .install-link { margin-block-start: 12px; }
  .hierarchy { display: grid; gap: 6px; margin-block-start: 12px; }
  .hierarchy li { display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline; padding: 8px 12px; background: var(--ink-900); border-radius: var(--radius-sm); }
  .hierarchy li + li { margin-inline-start: 14px; }
  .h-role { font-size: var(--fs-xs); color: var(--text-muted); font-weight: 700; min-inline-size: 7em; }
</style>
