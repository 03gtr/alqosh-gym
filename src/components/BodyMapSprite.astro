---
/**
 * Front and back anatomical figures defined ONCE per page as SVG symbols.
 * Body maps reference them with <use>; the muscle colours come from CSS custom
 * properties set on each <svg> (see visual/anatomy.ts).
 */
import { BODYMAP_VIEWBOX, bodyMapMarkup } from '../visual/render';
---

<svg class="fig bm-sprite" aria-hidden="true" focusable="false" width="0" height="0">
  <defs>
    <symbol id="bm-anterior" viewBox={BODYMAP_VIEWBOX} set:html={bodyMapMarkup('anterior')} />
    <symbol id="bm-posterior" viewBox={BODYMAP_VIEWBOX} set:html={bodyMapMarkup('posterior')} />
  </defs>
</svg>

<style>
  .bm-sprite { position: absolute; inline-size: 0; block-size: 0; overflow: hidden; }
</style>
