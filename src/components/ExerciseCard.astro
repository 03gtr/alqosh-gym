---
/**
 * Library card — calm hierarchy: visual → name → other-language name →
 * primary muscle (green, like the anatomy) → level · equipment.
 * Everything else lives on the exercise page.
 */
import DifficultyBadge from './DifficultyBadge.astro';
import BodyMap from './BodyMap.astro';
import type { Exercise } from '../data/exercises/types';
import { EQUIPMENT, MUSCLES } from '../data/taxonomy';
import { resolveMedia } from '../utils/media';
import { localePath, url, type Lang } from '../i18n/utils';

interface Props {
  exercise: Exercise;
  lang: Lang;
  /** Heading level for the card title. */
  level?: 'h2' | 'h3';
}
const { exercise: e, lang, level = 'h3' } = Astro.props;
const Heading = level;
const media = resolveMedia(e);
const primaryName = lang === 'ar' ? e.arabicName : e.name;
const secondaryName = lang === 'ar' ? e.name : e.arabicName;
const muscle = MUSCLES[e.primaryMuscles[0]].label[lang];
const equipment = e.equipment
  .filter((q) => q !== 'bodyweight' || e.equipment.length === 1)
  .slice(0, 1)
  .map((q) => EQUIPMENT[q].label[lang])
  .join('');
---

<article class="ex-card card-link" data-slug={e.slug}>
  <a class="ex-link" href={localePath(lang, `/exercises/${e.slug}/`)}>
    <div class:list={['ex-thumb', { 'ex-thumb--map': !media.poster }]}>
      {media.poster
        ? <img src={url(media.poster)} alt="" loading="lazy" decoding="async" width="320" height="240" />
        : <BodyMap lang={lang} primary={e.primaryMuscles} secondary={e.secondaryMuscles} views="best" labels={false} class="ex-bodymap" />}
    </div>
    <div class="ex-body">
      <Heading class="ex-title">{primaryName}</Heading>
      <p class="ex-alt" lang={lang === 'ar' ? 'en' : 'ar'} dir={lang === 'ar' ? 'ltr' : 'rtl'}>{secondaryName}</p>
      <p class="ex-muscle">{muscle}</p>
      <p class="ex-meta">
        <DifficultyBadge level={e.difficulty} lang={lang} plain />
        {equipment && <span class="ex-equip">{equipment}</span>}
      </p>
    </div>
  </a>
</article>

<style>
  .ex-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
  }
  .ex-card:hover { border-color: var(--line-strong); }
  .ex-link { display: flex; flex-direction: column; inline-size: 100%; text-decoration: none; color: inherit; }
  .ex-link:focus-visible { outline: 3px solid var(--focus); outline-offset: -3px; }
  .ex-thumb { position: relative; overflow: hidden; background: var(--ink-900); }
  .ex-thumb img { display: block; inline-size: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  /* Fixed-height anatomy strip: the figure can never grow into the text below. */
  .ex-thumb--map { block-size: 116px; display: grid; place-items: center; padding-block: 6px; }
  .ex-thumb :global(.ex-bodymap) { block-size: 104px; }
  .ex-thumb :global(.ex-bodymap .bm-view) { block-size: 104px; max-inline-size: none; }
  .ex-thumb :global(.ex-bodymap svg) { block-size: 104px; inline-size: auto; }
  .ex-body { padding: 10px 12px 12px; display: grid; gap: 2px; flex: 1; align-content: start; }
  .ex-title { font-size: 1rem; line-height: 1.4; }
  .ex-alt { font-size: var(--fs-xs); color: var(--text-dim, var(--text-muted)); line-height: 1.35; }
  .ex-muscle { font-size: var(--fs-sm); color: var(--mus-primary); font-weight: 800; margin-block-start: 4px; }
  .ex-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 10px; margin-block-start: 2px; }
  .ex-equip { font-size: var(--fs-xs); color: var(--text-muted); }
  @media (min-width: 640px) {
    .ex-body { padding: 12px 14px 14px; }
    .ex-title { font-size: 1.05rem; }
  }
</style>
