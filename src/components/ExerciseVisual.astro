---
/**
 * The exercise's visual demonstration + target-muscle map.
 *
 * Display order (first available wins), the page never changes:
 *   1. Professional media in public/media/exercises/ (WebM/MP4, WebP/GIF)
 *   2. Generated anatomical SVG animation (movement template, QC-gated)
 *   3. Static anatomical illustration with the GREEN primary muscles
 * The muscle map + legend are always shown: GREEN = primary target muscle.
 */
import Icon from './Icon.astro';
import BodyMap from './BodyMap.astro';
import MuscleLegend from './MuscleLegend.astro';
import type { Exercise } from '../data/exercises/types';
import { resolveMedia } from '../utils/media';
import { visualFor } from '../visual/assign';
import { muscleVars } from '../visual/anatomy';
import { viewBoxFor, visualMarkup } from '../visual/render';
import { url, useT, type Lang } from '../i18n/utils';

interface Props {
  exercise: Exercise;
  lang: Lang;
}
const { exercise: e, lang } = Astro.props;
const t = useT(lang);
const media = resolveMedia(e);
const visual = media.hasAnimation ? null : visualFor(e);
const mode: 'media' | 'anim' | 'static' = media.hasAnimation ? 'media' : visual ? 'anim' : 'static';
const name = lang === 'ar' ? e.arabicName : e.name;
const isVideo = Boolean(media.webm || media.mp4);
const vars = muscleVars(e.primaryMuscles, e.secondaryMuscles);
const phases = [t('ex.phaseStart'), t('ex.phaseMove'), t('ex.phaseEnd'), t('ex.phaseReturn')];
const animMode = visual?.template.mode;
---

<figure class:list={['xv', `xv--${mode}`]} data-visual={visual?.id}>
  <div class="xv-stage">
    {mode === 'media' && (
      <div class="media-frame" data-media>
        {isVideo ? (
          <video class="media-el" data-video muted loop playsinline preload="metadata" poster={media.poster ? url(media.poster) : undefined} aria-label={name}>
            {media.webm && <source src={url(media.webm)} type="video/webm" />}
            {media.mp4 && <source src={url(media.mp4)} type="video/mp4" />}
          </video>
        ) : (
          <img class="media-el" src={url((media.webp ?? media.gif)!)} alt={name} loading="eager" decoding="async" width="640" height="480" />
        )}
      </div>
    )}

    {mode === 'anim' && visual && (
      <>
        <svg class="fig xv-svg" data-anim viewBox={viewBoxFor(visual.template)} style={vars} role="img" aria-label={`${name} — ${t('vis.animLabel')}`} set:html={visualMarkup(visual.template)} />
        {/* Only this exercise's template ships to the browser (keeps the player small). */}
        <script is:inline type="application/json" data-template set:html={JSON.stringify(visual.template).replace(/</g, '\\u003c')} />
        {animMode !== 'hold' ? (
          <div class="xv-controls" role="group" aria-label={t('vis.controls')}>
            <button type="button" class="ctl" data-play aria-pressed="true">
              <span data-label-pause><Icon name="pause" size={16} /><span class="sr-only">{t('vis.pause')}</span></span>
              <span data-label-play hidden><Icon name="play" size={16} /><span class="sr-only">{t('vis.play')}</span></span>
            </button>
            <button type="button" class="ctl" data-replay aria-label={t('vis.replay')}><Icon name="replay" size={16} /></button>
            <button type="button" class="ctl ctl--text" data-slow aria-pressed="false" aria-label={t('vis.slowLabel')}><bdi dir="ltr">0.5×</bdi></button>
          </div>
        ) : (
          <span class="xv-hold">{t('vis.hold')}</span>
        )}
      </>
    )}

    {mode === 'static' && (
      <div class="xv-static">
        <BodyMap lang={lang} primary={e.primaryMuscles} secondary={e.secondaryMuscles} views="both" />
      </div>
    )}
  </div>

  <div class="xv-muscles">
    {mode !== 'static' && (
      <BodyMap lang={lang} primary={e.primaryMuscles} secondary={e.secondaryMuscles} views="both" class="xv-map" />
    )}
    <MuscleLegend lang={lang} primary={e.primaryMuscles} secondary={e.secondaryMuscles} />
  </div>

  <figcaption class="xv-caption">
    <ol class="phases" role="list" aria-label={t('ex.phases')}>
      {phases.map((p, i) => <li data-phase={i}><span class="num">{i + 1}</span>{p}</li>)}
    </ol>
    <p class="xv-note">
      {mode === 'anim' && t('vis.diagramNote')}
      {mode === 'static' && t('vis.staticNote')}
      {mode === 'media' && media.credit && <>{t('ex.mediaCredit')}: {media.credit}</>}
    </p>
  </figcaption>
</figure>

<script>
  import '../scripts/visual-player';

  // Professional video assets: autoplay only when visible and motion is allowed.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const video of document.querySelectorAll<HTMLVideoElement>('[data-media] [data-video]')) {
    video.controls = reduce;
    if (!reduce && 'IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        for (const en of entries) {
          if (en.isIntersecting) void video.play().catch(() => undefined);
          else video.pause();
        }
      }, { threshold: 0.4 }).observe(video);
    }
  }
</script>

<style>
  .xv { margin: 0; display: grid; gap: 10px; }
  .xv-stage {
    position: relative; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden;
    background: radial-gradient(120% 90% at 50% 10%, #17171c, #0b0b0d 70%);
  }
  .xv-svg { aspect-ratio: 13 / 10; }
  .media-frame { aspect-ratio: 4 / 3; background: #fff; }
  .media-el { inline-size: 100%; block-size: 100%; object-fit: contain; }
  .xv-static { padding: 14px 8px 6px; }
  .xv-static :global(.bm-view) { max-inline-size: 170px; }

  .xv-controls { position: absolute; inset-block-end: 8px; inset-inline-end: 8px; display: flex; gap: 6px; }
  .ctl {
    display: grid; place-items: center; min-inline-size: 40px; block-size: 40px; padding: 0 8px;
    background: rgb(13 13 15 / 0.85); color: var(--white); border: 1px solid var(--line-strong); border-radius: var(--radius-sm);
    font-weight: 800; font-size: var(--fs-sm);
  }
  .ctl:hover { border-color: var(--white); }
  .ctl[aria-pressed='true'].ctl--text { background: var(--accent); border-color: var(--accent); }
  .ctl :global(svg) { display: block; }
  .xv-hold {
    position: absolute; inset-block-start: 8px; inset-inline-start: 8px; padding: 2px 10px; border-radius: 999px;
    background: var(--accent); color: var(--white); font-weight: 800; font-size: var(--fs-xs);
  }

  .xv-muscles {
    display: grid; grid-template-columns: minmax(150px, 46%) 1fr; gap: 12px; align-items: center;
    padding: 10px 12px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
  }
  .xv--static .xv-muscles { grid-template-columns: 1fr; }
  .xv-muscles :global(.xv-map) { inline-size: 100%; }
  .xv-muscles :global(.xv-map .bm-view) { max-inline-size: none; }
  .xv-muscles :global(.xv-map .bm-view figcaption) { font-size: 0.7rem; }

  .phases { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
  .phases li {
    display: flex; align-items: center; gap: 6px; padding: 6px 8px; font-size: var(--fs-xs); font-weight: 800;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-sm); line-height: 1.25;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .phases li.is-active { border-color: var(--accent); background: var(--red-glow); }
  .num {
    flex: none; inline-size: 20px; block-size: 20px; display: grid; place-items: center; border-radius: 50%;
    background: var(--accent); color: var(--white); font-size: 0.72rem;
  }
  .xv-note { font-size: var(--fs-xs); color: var(--text-dim); margin-block-start: 6px; }
  @media (max-width: 400px) {
    .phases { grid-template-columns: repeat(2, 1fr); }
  }
</style>
