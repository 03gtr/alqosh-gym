---
/**
 * One official gym benefit, as a list row (use inside <ul class="benefit-list">).
 * All benefits are permanent — never shown as a promotion.
 */
import Icon from './Icon.astro';
import type { Benefit } from '../config/gym';
import type { Lang } from '../i18n/utils';

interface Props {
  benefit: Benefit;
  lang: Lang;
}
const { benefit, lang } = Astro.props;
---

<li class="benefit">
  <span class="benefit-icon" aria-hidden="true"><Icon name="check" size={18} /></span>
  <span class="benefit-title">{benefit.title[lang]}</span>
  <span class="benefit-detail">{benefit.detail[lang]}</span>
</li>

<style>
  .benefit {
    display: grid; grid-template-columns: auto 1fr auto; gap: 10px; align-items: center;
    padding-block: 12px; border-block-end: 1px solid var(--line);
  }
  .benefit:last-child { border-block-end: 0; }
  .benefit-icon {
    inline-size: 30px; block-size: 30px; display: grid; place-items: center; border-radius: 50%;
    color: var(--white); background: var(--red-glow); border: 1px solid rgb(225 6 0 / 0.5);
  }
  .benefit-title { font-weight: 800; line-height: 1.45; }
  .benefit-detail { color: var(--accent-text); font-weight: 800; font-size: var(--fs-sm); white-space: nowrap; }
</style>
