---
import { useT, type Lang } from '../i18n/utils';

interface Source {
  title: string;
  publisher?: string;
  year?: number;
  url?: string;
  doi?: string;
}
interface Props {
  lang: Lang;
  sources: Source[];
}
const { lang, sources } = Astro.props;
const t = useT(lang);
---

{sources.length > 0 && (
  <section class="sources" aria-labelledby="sources-h">
    <h2 id="sources-h">{t('article.sources')}</h2>
    <ol>
      {sources.map((s) => {
        const href = s.url ?? (s.doi ? `https://doi.org/${s.doi}` : undefined);
        return (
          <li dir="ltr" lang="en">
            {href ? <a href={href} target="_blank" rel="noopener noreferrer">{s.title}</a> : s.title}
            {(s.publisher || s.year) && <span class="meta"> — {[s.publisher, s.year].filter(Boolean).join(', ')}</span>}
            {s.doi && <span class="meta"> · doi:{s.doi}</span>}
          </li>
        );
      })}
    </ol>
  </section>
)}

<style>
  .sources { margin-block-start: 32px; padding-block-start: 18px; border-block-start: 1px solid var(--line); }
  .sources h2 { font-size: var(--fs-lg); margin-block-end: 10px; }
  .sources ol { display: grid; gap: 8px; font-size: var(--fs-sm); text-align: start; }
  .sources a { color: var(--accent-text); overflow-wrap: anywhere; }
  .meta { color: var(--text-muted); }
</style>
