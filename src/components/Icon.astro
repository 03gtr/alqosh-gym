---
/** Stroke icon (24×24, currentColor). Decorative unless `label` is given. */
import { ICONS, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
  /** Mirror horizontally in RTL (for directional icons like arrows). */
  flip?: boolean;
}

const { name, size = 22, label, class: className, flip = false } = Astro.props;
---

<svg
  class:list={['icon', className, { 'icon--flip': flip }]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <path d={ICONS[name]}></path>
</svg>

<style>
  .icon { flex: none; }
  :global(html[dir='rtl']) .icon--flip { transform: scaleX(-1); }
</style>
