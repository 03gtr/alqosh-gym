---
/** Pointer to the QR print guide — for gym staff (members reach exercises directly by scanning). */
import Icon from './Icon.astro';
import { localePath, useT, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<section class="qr-cta card card--cut" aria-labelledby="qr-cta-title">
  <div class="qr-art" aria-hidden="true">
    <Icon name="qr" size={48} />
  </div>
  <div class="qr-copy">
    <h2 id="qr-cta-title" class="qr-title">{t('qr.title')}</h2>
    <p class="qr-sub">{t('qr.subtitle')}</p>
    <p class="muted">{t('qr.body')}</p>
    <a class="btn btn--primary" href={localePath(lang, '/qr/')}>{t('qr.cta')}</a>
  </div>
</section>

<style>
  .qr-cta {
    display: grid; gap: 20px; align-items: center; padding: 24px;
    background:
      repeating-linear-gradient(135deg, rgb(255 255 255 / 0.025) 0 10px, transparent 10px 20px),
      var(--ink-800);
    border: 1px solid var(--line-strong);
  }
  .qr-art {
    inline-size: 76px; block-size: 76px; display: grid; place-items: center;
    background: var(--white); color: var(--black);
    clip-path: polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px);
  }
  .qr-copy { display: grid; gap: 8px; justify-items: start; }
  .qr-title { font-size: var(--fs-lg); }
  .qr-sub { font-weight: 800; color: var(--accent-text); font-size: var(--fs-sm); }
  @media (min-width: 640px) {
    .qr-cta { grid-template-columns: auto 1fr; padding: 32px; }
  }
</style>
