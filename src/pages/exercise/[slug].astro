---
/** Short QR alias: /exercise/<slug>/ → canonical /exercises/<slug>/ */
import RedirectView from '../../views/RedirectView.astro';
import { exercises } from '../../data/exercises';
import type { Exercise } from '../../data/exercises/types';

export function getStaticPaths() {
  return exercises.map((exercise) => ({ params: { slug: exercise.slug }, props: { exercise } }));
}

const { exercise } = Astro.props as { exercise: Exercise };
---

<RedirectView lang="ar" to={`/exercises/${exercise.slug}/`} label={exercise.arabicName} />
